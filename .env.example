# Sagra26 — ambiente di esempio
# Copia in .env e adatta. Nessun IP/hostname hardcoded nel codice.

APP_NAME="Sagra26"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Generico: su LAN usa http://nome-server:8000 o l'IP configurato sul mini-PC
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite — sostituisci col path ASSOLUTO del file sul server, es:
# DB_DATABASE=/home/utente/cassa/database/database.sqlite
DB_CONNECTION=sqlite
# DB_DATABASE=  (se vuoto Laravel usa database/database.sqlite relativo)

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

# Path del binario Chromium/Chrome per PDF headless (report)
# Ubuntu tipico: /usr/bin/chromium-browser oppure /usr/bin/chromium
# Mac tipico: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_PATH=/usr/bin/chromium-browser

# Codice di sblocco per reimpostare il PIN gestione se dimenticato (pagina /gestione/pin).
# Impostane uno diverso dal default prima di andare in produzione. Documentato in DEPLOY.md.
PIN_MASTER_RESET=cambiami-prima-della-sagra
